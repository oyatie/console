    visibility = ["PUBLIC"],
)

# Source-only integrity inputs; no compiler or toolchain selection.
[
    export_file(
        name = "hydration-" + source,
        src = source,
        visibility = ["PUBLIC"],
    )
    for source in ['BUCK']
]
