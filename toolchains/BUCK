config_setting(
    name = "wasm32",
    constraint_values = ["prelude//os/constraints:none", "prelude//cpu/constraints:wasm32"],
)

platform(
    name = "wasm32-platform",
    constraint_values = ["prelude//os/constraints:none", "prelude//cpu/constraints:wasm32"],
    visibility = ["PUBLIC"],
)

config_setting(
    name = "linux-arm64",
    constraint_values = ["prelude//os/constraints:linux", "prelude//cpu/constraints:arm64"],
)

config_setting(
    name = "linux-x86_64",
    constraint_values = ["prelude//os/constraints:linux", "prelude//cpu/constraints:x86_64"],
)

# Every rustc/rustdoc/clippy binary is an ARTIFACT from //rust:sysroot-<host>,
# hash-pinned in toolchains/rust/lock.bzl and derived from //rust-toolchain.toml.
# Nothing resolves from PATH, so the compiler is inside every action's digest.
hermetic_rust_toolchain(
    name = "rust",
    default_edition = "2024",
    rustc_flags = select({
        ":wasm32": ["-Copt-level=3", "-Cpanic=abort"],
        "DEFAULT": ["-Copt-level=0"],
    }),
    panic_runtime = select({":wasm32": "abort", "DEFAULT": "unwind"}),
    rustc_target_triple = select({
        ":wasm32": "wasm32-unknown-unknown",
        ":linux-x86_64": "x86_64-unknown-linux-gnu",
        ":linux-arm64": "aarch64-unknown-linux-gnu",
        "prelude//os:macos": "aarch64-apple-darwin",
    }),
    sysroot = select({
        ":wasm32": "//rust:hydrate-sysroot",
        ":linux-x86_64": "//rust:sysroot-x86_64-unknown-linux-gnu",
        ":linux-arm64": "//rust:sysroot-aarch64-unknown-linux-gnu",
        "prelude//os:macos": "//rust:sysroot-aarch64-apple-darwin",
    }),
    visibility = ["PUBLIC"],
)

_extra_cxx_link_flags = read_root_config("cxx", "link_flags", "")

system_cxx_toolchain(
    name = "cxx-host",
    compiler = "/usr/bin/clang",
    cxx_compiler = "/usr/bin/clang++",
    archiver = "/usr/bin/ar",
    linker = "/usr/bin/clang",
    link_flags = _extra_cxx_link_flags.split(" ") if _extra_cxx_link_flags else [],
    visibility = ["PUBLIC"],
)

cxx_tools_info_toolchain(
    name = "cxx-wasm-base",
    cxx_tools_info = "//rust:wasm-cxx-tools",
    visibility = ["PUBLIC"],
)

wasm_cxx_toolchain(
    name = "cxx-wasm",
    base = ":cxx-wasm-base",
    visibility = ["PUBLIC"],
)

toolchain_alias(
    name = "cxx",
    actual = select({":wasm32": ":cxx-wasm", "DEFAULT": ":cxx-host"}),
    visibility = ["PUBLIC"],
)

system_genrule_toolchain(
