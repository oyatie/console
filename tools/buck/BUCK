# These non-generated adapters ensure the app PostgreSQL suites receive the
# disposable harness environment only inside their test processes. Never call
# the generated app test targets directly from CI: that would bypass the
# credential-file loader and expose the runner to raw PostgreSQL target labels.
sh_test(
    name = "app-inline-postgres",
    test = "run_test_with_postgres_env.sh",
    args = ["$(location //backend/app:console-app-itest-inline-postgres)"],
    deps = ["//backend/app:console-app-itest-inline-postgres"],
    labels = ["test.integration", "resource.postgres", "needs-postgres"],
)

