        ],
        [
          "cad_media_reference",
          "Yes",
          "Media reference",
          "The CAD model file. This property accepts any of the formats listed in Supported model formats. Vulcan detects the format from the file extension."
        ],
        [
          "up_axis",
          "No",
          "String",
          "The up-axis convention of the model. Accepted values are X, Y, and Z. If omitted, Vulcan applies a format-specific default: Y for GLB and GLTF, Z for STL, OBJ, PLY, 3MF, DXF, LAS, and LAZ."
        ],
        [
          "model_unit",
          "No",
          "String",
          "How Vulcan interprets the model's coordinates when the file declares no unit of its own. Set this property for OBJ, STL, PLY, DXF, LAS, and LAZ, which never declare a unit. This property has no effect on GLB, GLTF, or 3MF, because Vulcan always reads the unit those formats declare. Accepted values are m (or meter / metre) and mm (or millimeter / millimetre). Vulcan ignores any other value."
        ]
      ],
