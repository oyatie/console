# Copy to .env (never commit .env — it is in .gitignore).
# Prefer the repository dev-up command to provision the separate database roles.
# Manual API configuration below requires an already reconciled topology.
# Replace each distinct placeholder and percent-encode reserved password characters.
# Use the same host, port and database for every transport.
CONSOLE_APP_ROLE=api
DATABASE_URL=postgres://console_rt:CHANGE_RUNTIME_PASSWORD@localhost:5432/console_dev
LEAVE_COMMAND_DATABASE_URL=postgres://console_leave_cmd:CHANGE_LEAVE_PASSWORD@localhost:5432/console_dev
ONTOLOGY_COMMAND_DATABASE_URL=postgres://console_ontology_cmd:CHANGE_ONTOLOGY_PASSWORD@localhost:5432/console_dev
PLATFORM_FORCE_COMMAND_DATABASE_URL=postgres://console_platform_force_cmd:CHANGE_FORCE_PASSWORD@localhost:5432/console_dev
# Required when API authentication is enabled; never use migration/admin credentials.
AUTH_DATABASE_URL=postgres://console_auth_rt:CHANGE_AUTH_PASSWORD@localhost:5432/console_dev

# Local/dev/e2e only: allow the OTP-logging email stub when no complete SMTP
# relay is configured. Do not set this in production; production must provide the
# full CONSOLE_EMAIL_* SMTP group.
CONSOLE_EMAIL_STUB_MODE=local

# Public storefront/support intake tenant. Keep KNL's seeded tenant locally unless
# the public CX tenant was re-minted via platform onboarding.
STOREFRONT_ORG_ID=00000000-0000-0000-0000-0000000000a1

# Set to true for CI where no live DB is available (uses committed .sqlx/ cache).
# SQLX_OFFLINE=true

# Regenerate the offline query cache after any schema or query change:
#   DATABASE_URL=postgres://YOUR_OS_USERNAME@localhost/console_dev cargo sqlx prepare --workspace -- --all-targets
# (--all-targets is REQUIRED so the cache covers #[sqlx::test] queries; CI runs clippy offline.)
# Then commit the updated .sqlx/ directory.
